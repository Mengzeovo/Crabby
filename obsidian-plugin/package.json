{
  "name": "crabby",
  "version": "0.3.5",
  "private": true,
  "scripts": {
    "dev": "esbuild src/main.ts --bundle --outfile=main.js --format=cjs --platform=node --external:obsidian --sourcemap --watch",
    "dev:active": "node scripts/dev-active.js",
    "build": "esbuild src/main.ts --bundle --outfile=main.js --format=cjs --platform=node --external:obsidian --minify",
    "test:chat-content": "node scripts/test-chat-assistant-content.js",
    "test:chat-tools": "node scripts/test-chat-tools.js",
    "test:chat-styles": "node scripts/test-chat-styles.js",
    "test:api-client": "node scripts/test-api-client-abort.js",
    "test:turn-manager": "node scripts/test-chat-turn-manager.js",
    "test:config": "node scripts/test-backend-config.js",
    "test:search-index": "node scripts/test-search-index.js",
    "test:wing-mapping": "node scripts/test-wing-mapping.js",
    "test:source-resolver": "node scripts/test-source-resolver.js"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.21",
    "obsidian": "^1.6",
    "typescript": "^5.5"
  }
}

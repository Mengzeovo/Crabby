# Chat / LLM
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_SUPPORTS_VISION=false
LLM_THINKING_MODE=
LLM_THINKING_BUDGET_TOKENS=1024
LLM_REASONING_EFFORT=
LLM_REASONING_SPLIT=false

# Anthropic, only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenAI-compatible providers, only needed when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama, only needed when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Built-in OpenAI-compatible provider presets
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
ZAI_API_KEY=

# Vault
VAULT_PATH=D:/path/to/your/ObsidianVault

# Server
HOST=127.0.0.1
PORT=8000

# Local admin reload API used by the Obsidian plugin settings page
CRABBY_ADMIN_ENABLED=true
CRABBY_ADMIN_TOKEN=change-me

# MCP secrets referenced by server/data/mcp_servers.json
MINIMAX_API_KEY=

# Optional tool/runtime settings
BASH_ENABLED=true
BASH_TIMEOUT=30
BASH_MAX_TIMEOUT=120
SKILLS_ENABLED=true
PERSONAS_ENABLED=true
PROMPTS_DIR=
PERSONAS_DIR=

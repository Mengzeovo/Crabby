# =============================================================================
# Crabby Server Configuration
# =============================================================================
# Copy this file to <vault>/.crabby/config/.env and fill in your values.
# In development (no VAULT_PATH set), the server reads from the repo root.
# In production, it always reads from <vault>/.crabby/config/.env.

# ---- LLM Provider ------------------------------------------------------------
# Choose: anthropic | openai | deepseek | ollama | kimi | minimax | zhipu | custom_openai
LLM_PROVIDER=anthropic

# Provider API keys (fill at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
BAILIAN_CODING_PLAN_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=

# Provider base URLs (for proxy/custom endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434

# Model
LLM_MODEL=claude-sonnet-4-20250514

# Optional: thinking/reasoning controls
# LLM_THINKING_MODE=enable
# LLM_THINKING_BUDGET_TOKENS=1024

# ---- Tooling -----------------------------------------------------------------
BASH_ENABLED=true
BASH_TIMEOUT=30
BASH_MAX_TIMEOUT=120

# ---- Auto-Save (MemPalace) ---------------------------------------------------
# Interval in conversation turns before triggering auto-save
AUTO_SAVE_INTERVAL=15

# MemPalace palace directory (auto-saved memories, diary, knowledge graph)
# Default: <vault>/.crabby/data/mempalace
# MEMPALACE_PALACE_PATH=

# ---- Ollama Embedding (optional) --------------------------------------------
# Leave empty to use MemPalace's sentence-transformers (no extra install needed).
# Set to "Qwen3-Embedding-4B" or "BAAI/bge-m3" if Ollama is installed and running.
# MemPalace auto-detects Ollama and falls back to sentence-transformers if unavailable.
# OLLAMA_EMBEDDING_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434

# ---- Personas & Skills -------------------------------------------------------
PERSONAS_ENABLED=true
SKILLS_ENABLED=true

# ---- Admin UI ----------------------------------------------------------------
CRABBY_ADMIN_ENABLED=false
CRABBY_ADMIN_TOKEN=

# ---- Vault (usually set automatically by the Obsidian plugin) ----------------
# VAULT_PATH=D:/path/to/your/vault
